# GEMINI_API_KEY: Required for Gemini AI API calls (OCR & fallback generation).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Optional/Primary OpenAI API Key for pedagogical analysis and generation.
# Kept securely on the server-side only.
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# Vercel AI Gateway image generation. On Vercel, VERCEL_OIDC_TOKEN is injected automatically;
# for local/other environments set AI_GATEWAY_API_KEY. Never expose either with a VITE_ prefix.
AI_GATEWAY_API_KEY="YOUR_AI_GATEWAY_KEY"
SLIDE_IMAGE_MODEL="google/imagen-4.0-ultra-generate-001"
SLIDE_IMAGE_FALLBACK_MODEL="openai/gpt-image-2"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Supabase publishable configuration. The secret/service-role key must never use a VITE_ prefix.
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_ANON_KEY="YOUR_PUBLISHABLE_KEY"
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_PUBLISHABLE_KEY"
